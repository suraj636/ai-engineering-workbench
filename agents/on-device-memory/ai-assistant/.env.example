# Copy to .env, then run: uv run python app.py
#
# The defaults were measured with a 1280x720 desk camera. A different camera,
# distance, or lighting changes the scores; re-teach the object if you change
# rotation, because CLIP does not ignore image rotation.

# --- recognition ------------------------------------------------------------

# Minimum cosine similarity for a match. Unrelated same-camera objects often
# score 0.75-0.85, so 0.90 does not mean "90% confident."
# Too low: everything matches the last thing you taught.
# Too high: the object stops matching when it turns or the light shifts.
RECOGNIZE_THRESHOLD=0.90

# --- detection (only with the `detect` extra installed) ---------------------

# Raise to track less clutter.
DETECT_CONF=0.30

# Largest detection kept, as a fraction of the frame. Drops walls and desks.
DETECT_MAX_AREA=0.20

# Smallest detection kept, as a fraction of the frame.
DETECT_MIN_AREA=0.001

# --- camera -----------------------------------------------------------------

CAMERA_INDEX=0

# 0 for an upright camera, 180 for an upside-down one. Set before teaching:
# changing it invalidates every taught view.
CAMERA_ROTATE=0

# Crop a lens rim: one fraction for every edge, or left,top,right,bottom.
FRAME_CROP=0

# --- server and storage -----------------------------------------------------

PORT=8765

# Place stamped on new memories, e.g. desk. Recall reads it back.
# WHERE=desk
