# ---------------------------------------------------------------------------
# Plivo
# ---------------------------------------------------------------------------
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Your Plivo voice-enabled number in E.164 format, e.g. +14155550123
PLIVO_PHONE_NUMBER=
# Public HTTPS origin that Plivo can reach (ngrok/cloudflared in development).
# Example: https://your-subdomain.ngrok-free.app
PUBLIC_BASE_URL=
# Validate X-Plivo-Signature-V3 on webhooks. Leave false behind ngrok during
# local development; set true in production (requires PLIVO_AUTH_TOKEN).
PLIVO_VALIDATE_SIGNATURE=false

# ---------------------------------------------------------------------------
# AssemblyAI Universal Streaming
# ---------------------------------------------------------------------------
ASSEMBLYAI_API_KEY=
# Universal-3.5 Pro Streaming (supported: universal-3-6-pro | universal-3-5-pro |
# universal-streaming-english | universal-streaming-multilingual).
# Docs: https://www.assemblyai.com/docs/streaming/getting-started/transcribe-streaming-audio
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
ASSEMBLYAI_SAMPLE_RATE=16000
# Optional turn-detection tuning. Leave blank to use AssemblyAI's defaults.
# mode + interruption_delay are Universal-3.5 Pro Streaming features.
ASSEMBLYAI_MODE=min_latency
# ASSEMBLYAI_MIN_TURN_SILENCE=128
# ASSEMBLYAI_MAX_TURN_SILENCE=1280
# ASSEMBLYAI_VAD_THRESHOLD=0.2
# Lower = faster barge-in. The server adds ~256 ms on top of this value.
ASSEMBLYAI_INTERRUPTION_DELAY=150

# ---------------------------------------------------------------------------
# Sarvam 105B
# ---------------------------------------------------------------------------
SARVAM_API_KEY=
# sarvam-105b | sarvam-105b-conversations (voice-tuned variant)
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TEMPERATURE=0.6
SARVAM_MAX_TOKENS=300

# ---------------------------------------------------------------------------
# Text to speech
# ---------------------------------------------------------------------------
# Active provider: inworld | speechify | sarvam
TTS_PROVIDER=sarvam

# Inworld TTS 2
INWORLD_API_KEY=
# inworld-tts-2 | inworld-tts-2-flash
INWORLD_TTS_MODEL=inworld-tts-2
# Any voice ID available in your Inworld workspace (examples: Ashley, Hana, Dennis)
INWORLD_VOICE_ID=Ashley
# MULAW at 8 kHz is Plivo's native format; PCM is also supported (the backend
# resamples to 8 kHz μ-law before playback).
INWORLD_AUDIO_ENCODING=MULAW
INWORLD_SAMPLE_RATE=8000
INWORLD_SPEAKING_RATE=1.0
INWORLD_DELIVERY_MODE=BALANCED
# true: speak each chunk as it is sent (manual mode + flush, faster first audio).
# false: Inworld waits for a sentence end (SENTENCE_BOUNDARY auto mode, Preview).
INWORLD_FLUSH_PER_CHUNK=true

# Speechify Simba 3.5 (https://platform.speechify.ai)
SPEECHIFY_API_KEY=
# simba-3.5 (recommended, 48 languages) | simba-3.2 | simba-3.0
SPEECHIFY_MODEL=simba-3.5
# Indian English set: Ankit and Arun (male, en-IN), plus Mihika (Hindi),
# Aadhya (Telugu) and Revati (Marathi) as the female voices.
# Mihika is the default; this is the API voice ID, not the display name.
SPEECHIFY_VOICE_ID=mihika
# Language of the input. en-IN lets the Indian-language female voices speak
# English with their native Indian accent instead of their own locale.
SPEECHIFY_LANGUAGE=en-IN
# The backend always requests raw 8 kHz μ-law for telephony.
SPEECHIFY_OUTPUT_FORMAT=ulaw_8000
# SPEECHIFY_BASE_URL=https://api.speechify.ai

# Sarvam Bulbul v4 Flash TTS (WebSocket, uses SARVAM_API_KEY from above)
# Select with TTS_PROVIDER=sarvam. Always requests 8 kHz mulaw (Plivo native).
SARVAM_TTS_MODEL=bulbul:v4-flash
# Speaker names are model-specific: v4-flash personas look like <name>_<lang>_<style>.
SARVAM_TTS_VOICE_ID=simran_en_customer
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_PACE=1.0

# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------
# {salutation} -> Good morning/afternoon/evening in Perth time (UTC+8) at call start
AGENT_GREETING={salutation}, Hardline Landscape & Construction, this is Natalie. How can I help?
# The built-in production prompt (backend/config.py, under 1,000 tokens) is used
# when this is blank. Set your own only if you need business-specific facts.
# AGENT_SYSTEM_PROMPT=You are the voice assistant for Acme. Speak naturally, keep replies short, and never invent prices or policies.
AGENT_MAX_HISTORY_MESSAGES=20
MAX_CALL_SECONDS=900
IDLE_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Cost estimation
# Static official list prices are built in (backend/pricing.py, as of
# 2026-10-29). Leave blank to use them; override only for contracted rates.
# ---------------------------------------------------------------------------
# AssemblyAI Universal-3.5/3.6 Pro Realtime, USD per hour (billed per session)
PRICING_ASR_PER_HOUR=0.45
# LLM estimate, USD per 1M characters generated by Sarvam-105B
# Static default derives ₹60/1M output tokens at 4 chars/token and ₹95/USD.
PRICING_LLM_PER_1M_GENERATED_CHARS=0.157895
# Sarvam 105B by token (USD per 1M). Defaults are INR 15 / 5 / 60 at USD_INR 95.
# PRICING_LLM_INPUT_PER_1M_TOKENS=0.157895
# PRICING_LLM_CACHED_PER_1M_TOKENS=0.052632
# PRICING_LLM_OUTPUT_PER_1M_TOKENS=0.631579
# Inworld TTS by model, USD per 1M characters (On-Demand list; monthly plans are cheaper).
# PRICING_INWORLD_TTS_2_PER_1M_CHARS=25
# PRICING_INWORLD_TTS_2_FLASH_PER_1M_CHARS=15
# Speechify Simba 3.5 Starter promo, USD per 1M characters (through 21 Nov 2026)
PRICING_TTS_PER_1M_CHARS=10.0
# Sarvam Bulbul v4 Flash, USD per 1M characters (INR 1,000/1M at INR 95/USD)
PRICING_SARVAM_TTS_PER_1M_CHARS=10.526316

# ---------------------------------------------------------------------------
# Startup warm-up
# Provider sessions are warmed in the background; startup never blocks on them.
# ---------------------------------------------------------------------------
WARMUP_ON_START=true
# Per-provider timeout in seconds.
WARMUP_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# pretty (default): one readable line per event | json: one JSON object per line
LOG_FORMAT=pretty
# true adds trimmed caller/agent text to each turn's log line (privacy: off by default)
LOG_TRANSCRIPTS=false

# SQLite file for saved call history (Cost & latency page). Default: data/calls.db
# DB_PATH=data/calls.db
